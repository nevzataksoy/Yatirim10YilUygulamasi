{
  "name": "tr-rosayazilim-yatirimdashboard",
  "versionCode": 2,
  "version": "1.0.2",
  "description": "10 Yıllık sabit birikim ve dönüşüm odaklı modern portföy ve yatırım karar destek uygulaması",
  "productName": "Yatırım 10Yıl",
  "author": "nevzataksoy <nevzataksoy@windowslive.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare --silent",
    "icons": "icongenie generate -i app-icon.png --skip-trim --theme-color B7073C --splashscreen-icon-ratio 25",
    "add:capacitor": "quasar mode add capacitor",
    "dev:android": "quasar dev -m capacitor -T android",
    "build:android": "quasar build -m capacitor -T android --ide",
    "build:newapk": "quasar build -m capacitor -T android --ide && \"C:\\Program Files\\Android\\Android Studio\\bin\\studio64.exe\" \"D:\\wamp64\\www\\Yatirim10YilUygulamasi\\tr-rosayazilim-yatirimdashboard\\src-capacitor\\android\"",
    "add:pwa": "quasar mode add pwa",
    "dev:pwa": "quasar dev -m pwa",
    "build:pwa": "quasar dev -m pwa"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/push-notifications": "^8.1.2",
    "vue-i18n": "^11.3.0",
    "pinia": "^4.0.2",
    "@quasar/extras": "^2.0.0",
    "@supabase/supabase-js": "^2.111.0",
    "decimal.js": "^10.6.0",
    "quasar": "^2.24.0",
    "secure-ls": "^2.0.0",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "prettier": "^3.8.1",
    "@quasar/app-vite": "^3.4.1",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
